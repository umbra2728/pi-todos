{
  "name": "pi-todos",
  "version": "0.1.3",
  "description": "Incremental session-native todo tracking for Pi with lifecycle actions, dependencies, replay, and a live overlay.",
  "type": "module",
  "license": "MIT",
  "author": "umbra2728",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umbra2728/pi-todos.git"
  },
  "homepage": "https://github.com/umbra2728/pi-todos#readme",
  "bugs": {
    "url": "https://github.com/umbra2728/pi-todos/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "todo",
    "tasks"
  ],
  "files": [
    "src",
    "scripts",
    "README.md",
    "CHANGELOG.md",
    "CONCEPT.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check:no-comments": "python3 scripts/check_no_comments.py",
    "check": "npm run typecheck && npm test && npm run check:no-comments && npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.5.0",
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@earendil-works/pi-tui": "^1.5.0",
    "@types/node": "^22.0.0",
    "typebox": "^1.3.0",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "provenance": true
  }
}
